{
	"schemaVersion": 1,
	"id": "recoil",
	"version": "${version}",
	"name": "Recoil",
	"description": "Advanced Fabric client mod backend for Minecraft 1.21.11",
	"authors": [
		"Recoil Team"
	],
	"contact": {
		"homepage": "https://github.com/recoil",
		"sources": "https://github.com/recoil/recoil"
	},
	"license": "MIT",
	"icon": "assets/recoil/icon.png",
